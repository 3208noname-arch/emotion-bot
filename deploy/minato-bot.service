[Unit]
Description=Minato emotion bot (深夜の学食)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/minato-bot
ExecStart=/opt/monitorbot/venv/bin/python /opt/minato-bot/bot.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
