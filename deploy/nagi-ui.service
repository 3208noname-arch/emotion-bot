[Unit]
Description=Nagi web UI (様子・話題の好き嫌い)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/minato-bot
ExecStart=/opt/monitorbot/venv/bin/python /opt/minato-bot/ui.py 待ち受けるアドレス
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
